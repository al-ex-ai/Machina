{
  "name": "machina",
  "version": "0.1.0",
  "description": "Real aircraft in the browser, every part selectable, every size checked against published specs.",
  "license": "MIT",
  "author": "Alex Husniddinov",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
